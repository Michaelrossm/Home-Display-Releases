# One timing line for large rotated frames, not a per-strip log or new task.
function(home_display_add_render_diagnostics contents output)
    set(field "    size_t cache_line_size;")
    string(REPLACE "${field}" "${field}\n    int64_t home_frame_started_us;\n    uint32_t home_frame_pixels;\n    int64_t home_rotation_us;" patched "${contents}")
    string(FIND "${patched}" "static void display_bridge_v9_flush_partial_rotate(" begin REVERSE)
    string(FIND "${patched}" "/**********************\n *   ROTATION & COPY OPERATIONS" end)
    if(begin LESS 0 OR end LESS begin OR patched STREQUAL contents)
        message(FATAL_ERROR "Pinned rotated render diagnostic boundaries changed")
    endif()
    math(EXPR length "${end} - ${begin}")
    string(SUBSTRING "${patched}" ${begin} ${length} original)
    set(body "${original}")
    set(start "    const int rect_h = area->y2 - area->y1 + 1;")
    string(REPLACE "${start}" "${start}\n    if (!impl->home_frame_started_us) {\n        impl->home_frame_started_us = esp_timer_get_time();\n        impl->home_frame_pixels = 0;\n        impl->home_rotation_us = 0;\n    }\n    impl->home_frame_pixels += (uint32_t)(area->x2 - area->x1 + 1) * rect_h;" body "${body}")
    string(REPLACE "    rotate_copy_strided_region(color_map," "    const int64_t rotation_started_us = esp_timer_get_time();\n    rotate_copy_strided_region(color_map," body "${body}")
    string(REPLACE "    if (lv_display_flush_is_last(disp)) {" "    impl->home_rotation_us += esp_timer_get_time() - rotation_started_us;\n    if (lv_display_flush_is_last(disp)) {" body "${body}")
    foreach(indent "            " "                ")
        string(REPLACE "${indent}display_manager_flush_ready(disp);\n${indent}return;" "${indent}impl->home_frame_started_us = 0;\n${indent}display_manager_flush_ready(disp);\n${indent}return;" body "${body}")
    endforeach()
    set(finish "    /* Notify LVGL that flush is complete */")
    string(FIND "${body}" "${finish}" finish_offset)
    if(finish_offset LESS 0)
        message(FATAL_ERROR "Pinned rotated render completion changed")
    endif()
    string(REPLACE "${finish}" "    if (lv_display_flush_is_last(disp)) {\n        if (impl->home_frame_pixels >= (uint32_t)bridge_h_res(impl) * bridge_v_res(impl) / 2) {\n            ESP_LOGI(TAG, \"RENDER-DIAG pixels=%lu frame_ms=%lu rotation_ms=%lu\",\n                     (unsigned long)impl->home_frame_pixels,\n                     (unsigned long)((esp_timer_get_time() - impl->home_frame_started_us) / 1000),\n                     (unsigned long)(impl->home_rotation_us / 1000));\n        }\n        impl->home_frame_started_us = 0;\n    }\n${finish}" body "${body}")
    string(REPLACE "${original}" "${body}" patched "${patched}")
    set(${output} "${patched}" PARENT_SCOPE)
endfunction()

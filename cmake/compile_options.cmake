# Pioarduino imports CMake flags into SCons and can separate/reorder a two-token
# forced include. Join only that option; retain every unrelated option/definition.
function(home_display_normalize_forced_includes target)
    foreach(property COMPILE_OPTIONS INTERFACE_COMPILE_OPTIONS)
        get_target_property(options ${target} ${property})
        if(NOT options)
            continue()
        endif()
        set(normalized "")
        set(expect_file FALSE)
        foreach(option IN LISTS options)
            if(expect_file)
                list(APPEND normalized "-include${option}")
                set(expect_file FALSE)
            elseif(option STREQUAL "-include")
                set(expect_file TRUE)
            else()
                list(APPEND normalized "${option}")
            endif()
        endforeach()
        if(expect_file)
            message(FATAL_ERROR "Missing forced-include filename on ${target}")
        endif()
        set_property(TARGET ${target} PROPERTY ${property} "${normalized}")
    endforeach()
endfunction()

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Home-Display Lua App Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "name",
    "version",
    "type",
    "entry",
    "settings"
  ],
  "properties": {
    "schema": {
      "enum": [1, 2]
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9_-]{1,31}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 48
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 24
    },
    "type": {
      "const": "lua"
    },
    "icon": {
      "type": "string",
      "maxLength": 31
    },
    "entry": {
      "const": "main.lua"
    },
    "settings": {
      "type": "boolean"
    },
    "settingsEntry": {"const": "settings.lua"},
    "permissions": {
      "type": "array", "maxItems": 16, "uniqueItems": true,
      "items": {"enum": ["network.local", "network.internet", "storage", "secrets", "discovery", "mqtt", "websocket", "home_assistant", "energy", "media", "storage.read", "storage.writeAppData", "storage.nasRead", "system.wallpaper", "power.idleIntegration", "calendar.read", "calendar.write"]}
    },
    "background": {
      "type": "object", "additionalProperties": false, "required": ["enabled"],
      "properties": {
        "enabled": {"type": "boolean"},
        "priority": {"enum": ["none", "low", "normal", "important"]},
        "preferredIntervalMinutes": {"type": "integer", "minimum": 0, "maximum": 10080},
        "maximumDelayMinutes": {"type": "integer", "minimum": 0, "maximum": 10080},
        "requiresNetwork": {"type": "boolean"},
        "allowDuringHighLoad": {"type": "boolean"}
      }
    },
    "enabled": {
      "type": "boolean",
      "default": true
    },
    "minFirmware": {
      "type": "string",
      "maxLength": 24
    }
  },
  "allOf": [
    {"if": {"properties": {"schema": {"const": 2}}}, "then": {
      "required": ["permissions"],
      "allOf": [{"if": {"properties": {"settings": {"const": true}}}, "then": {"required": ["settingsEntry"]}, "else": {"not": {"required": ["settingsEntry"]}}}]
    }}
  ]
}
